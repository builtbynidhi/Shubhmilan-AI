# ───────────────────────────────────────────────────────────────────────────
# CLIENT (browser-exposed by design — Vite inlines VITE_* into the bundle).
# Only public keys belong here.
# ───────────────────────────────────────────────────────────────────────────

# Clerk (auth) — publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Groq AI (text rewrites + Kundli + compatibility) — called from the browser
VITE_GROQ_API_KEY=your-groq-api-key-here

# OpenAI — palm reading VISION passes (browser). Embeddings use the server key below.
VITE_OPENAI_API_KEY=sk-your-openai-key-here
# VITE_OPENAI_MODEL=gpt-4o   # optional override; defaults to gpt-4o

# Razorpay (public key id — safe to expose in browser)
VITE_RAZORPAY_KEY_ID=rzp_live_your-key-here

# App base URL (used for OG tags etc. — no trailing slash)
VITE_APP_URL=https://shubhmilan.ai

# ───────────────────────────────────────────────────────────────────────────
# SERVER ONLY — set in Vercel project env / local shell. NEVER prefix with VITE_
# (that would leak the secret into the browser bundle).
# ───────────────────────────────────────────────────────────────────────────

# Neon Postgres — POOLED string for runtime (api/* functions)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Neon Postgres — DIRECT/unpooled string for Drizzle Kit migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Clerk (auth) — secret key, used by api/* to verify session tokens
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# OpenAI — embedding key for palmistry RAG (ingestion script + palm-rag-retrieve)
OPENAI_API_KEY=sk-your-openai-key-here

# Razorpay — secret key for order creation + signature verification
RAZORPAY_KEY_ID=rzp_live_your-key-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# KUNDLI_FEE_INR=51   # optional override for the kundli generation fee
